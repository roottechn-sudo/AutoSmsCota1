<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_treasurer"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="☥ RAVA TRÉSORERIE"
            android:textColor="#A6F5A0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="En direct"
            android:textColor="#80FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Main Balance Area -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Solde Disponible"
        android:textColor="#B0BEC5"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_treasury_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 FCFA"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Footer with Pending Transactions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_pending_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="0 en attente"
            android:textColor="#FFB74D"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_btn_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ouvrir →"
            android:textColor="#A6F5A0"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
